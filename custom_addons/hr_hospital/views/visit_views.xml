<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- LIST VIEWS -->

    <record id="view_hospital_visit_list" model="ir.ui.view">
        <field name="name">hospital.visit.list</field>
        <field name="model">hr_hospital.visit</field>
        <field name="arch" type="xml">
            <list>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="disease_name"/>
                <field name="planned_datetime"/>
                <field name="visit_datetime"/>
                <field name="state"/>
                <field name="summary"/>
            </list>
        </field>
    </record>

    <!-- FORM VIEWS -->

    <record id="view_hospital_visit_form" model="ir.ui.view">
        <field name="name">hospital.visit.form</field>
        <field name="model">hr_hospital.visit</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_set_planned"
                            string="Planned"
                            type="object"
                            class="btn-secondary"
                            invisible="state == 'planned'"/>

                    <button name="action_done"
                            string="Done"
                            type="object"
                            class="btn-success"
                            invisible="state == 'done'"/>

                    <button name="action_cancel"
                            string="Cancel"
                            type="object"
                            class="btn-danger"
                            invisible="state == 'canceled'"/>

                    <button type="object"
                            name="action_open_same_disease_visits"
                            string="Same Disease"
                            class="btn-primary"/>

                    <field name="state" widget="statusbar"/>
                </header>


                <sheet>
                    <group>
                        <field name="patient_id"/>
                        <field name="doctor_id" domain="[('is_intern', '=', False)]"/>
                        <field name="disease_id"/>
                    </group>

                    <group>
                        <field name="planned_datetime"/>
                        <field name="visit_datetime"/>
                    </group>

                    <group>
                        <field name="summary"/>
                    </group>


                </sheet>
            </form>
        </field>
    </record>

    <!--    Calendar-->

    <record id="view_hospital_visit_calendar" model="ir.ui.view">
        <field name="name">hospital.visit.calendar</field>
        <field name="model">hr_hospital.visit</field>
        <field name="arch" type="xml">
            <calendar string="Visits"
                      date_start="planned_datetime"
                      date_stop="visit_datetime"
                      color="doctor_id">

                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="disease_id"/>
                <field name="state"/>

            </calendar>
        </field>
    </record>

    <record id="view_hospital_visit_search" model="ir.ui.view">
        <field name="name">hospital.visit.search</field>
        <field name="model">hr_hospital.visit</field>
        <field name="arch" type="xml">
            <search>

                <!-- Search-->
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="disease_id"/>

                <!-- Filters -->
                <filter name="filter_planned"
                        string="Planned"
                        domain="[('state', '=', 'planned')]"/>

                <filter name="filter_done"
                        string="Done"
                        domain="[('state', '=', 'done')]"/>

                <filter name="filter_canceled"
                        string="Canceled"
                        domain="[('state', '=', 'canceled')]"/>

                <!-- Filter: current year -->
                <filter name="current_year"
                        string="Current Year"
                        domain="[('planned_datetime', '&gt;=', (context_today().strftime('%Y-01-01'))),
                                ('planned_datetime', '&lt;=', (context_today().strftime('%Y-12-31')))]"/>

                <!-- GROUP BY states-->
                <filter name="group_by_state"
                        string="Status"
                        context="{'group_by': 'state'}"/>


                <searchpanel>
                    <field name="doctor_id"
                           string="Doctors"
                           select="multi"
                           enable_counters="1"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="view_hospital_visit_pivot" model="ir.ui.view">
        <field name="name">hospital.visit.pivot</field>
        <field name="model">hr_hospital.visit</field>
        <field name="arch" type="xml">
            <pivot string="Visits Analysis">

                <!-- Rows: doctors -->
                <field name="doctor_id" type="row"/>

                <!-- Columns: visit status -->
                <field name="state" type="col"/>

                <!-- Columns: grouped by month -->
                <field name="planned_datetime" interval="month" type="col"/>

            </pivot>
        </field>
    </record>

<!--    Graph-->

    <record id="view_hospital_visit_graph" model="ir.ui.view">
        <field name="name">hospital.visit.graph</field>
        <field name="model">hr_hospital.visit</field>
        <field name="arch" type="xml">
            <graph string="Visits Analysis" type="bar" stacked="True">

                <!-- X-axis: months -->
                <field name="planned_datetime" interval="month"/>

                <!-- Measure: number of visits -->
                <field name="id" type="measure"/>

                <!-- Colors (stack): diseases -->
                <field name="disease_id"/>

            </graph>
        </field>
    </record>

</odoo>