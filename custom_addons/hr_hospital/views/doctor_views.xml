<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!-- LIST VIEWS -->
    <record id="view_hospital_doctor_list" model="ir.ui.view">
        <field name="name">hospital.doctor.list</field>
        <field name="model">hr_hospital.doctor</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="gender"/>
                <field name="blood_group"/>
                <field name="category_id"/>
                <field name="is_intern" widget="boolean_toggle"/>
                <field name="mentor_id"/>
                <field name="age"/>
            </list>
        </field>
    </record>

    <!-- FORM VIEWS -->

    <record id="view_hospital_doctor_form" model="ir.ui.view">
        <field name="name">hospital.doctor.form</field>
        <field name="model">hr_hospital.doctor</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="gender"/>
                        <field name="blood_group"/>
                        <field name="birth_date"/>
                        <field name="specialization"/>
                        <field name="user_id"/>
                        <field name="age"/>
                    </group>

                    <group>
                        <field name="category_id"/>
                        <field name="is_intern"/>
                        <field name="mentor_id" invisible="not is_intern"/>
                    </group>

                    <notebook>
                        <page string="Interns" invisible="is_intern">
                            <field name="intern_ids">
                                <kanban>
                                    <field name="name"/>
                                    <field name="is_intern"/>
                                    <field name="gender"/>
                                    <field name="age"/>
                                    <field name="blood_group"/>
                                    <templates>
                                        <t t-name="card">
                                            <div class="oe_kanban_card">
                                                <strong>
                                                    <field name="name"/>
                                                </strong>
                                                <div>
                                                    <span t-if="record.is_intern.raw_value">👶 Intern</span>
                                                    <span t-else="">👨‍⚕️ Doctor</span>
                                                </div>

                                                <!-- Gender + Age -->
                                                <div>
                                                    <field name="gender"/>
                                                    |
                                                    <field name="age"/>
                                                    y.o.
                                                </div>

                                                <!-- Blood group -->
                                                <div>
                                                    🩸
                                                    <field name="blood_group"/>
                                                </div>
                                            </div>
                                        </t>
                                    </templates>
                                </kanban>
                            </field>
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

    <!-- KANBAN VIEW -->
<record id="view_hospital_doctor_kanban" model="ir.ui.view">
    <field name="name">hospital.doctor.kanban</field>
    <field name="model">hr_hospital.doctor</field>
    <field name="arch" type="xml">
        <kanban default_group_by="category_id">

            <!-- fields used -->
            <field name="name"/>
            <field name="is_intern"/>
            <field name="category_id"/>

            <templates>
                <t t-name="card">
                    <div class="oe_kanban_card">
                        <t t-if="!record.is_intern.raw_value">
                            <div>
                                <button type="object"
                                        name="action_create_visit"
                                        string="Create Visit"
                                        class="btn btn-primary btn-sm"/>
                            </div>
                        </t>

                        <strong>
                            <field name="name"/>
                        </strong>

                        <div>
                            <span t-if="record.is_intern.raw_value">Intern</span>
                            <span t-else="">Doctor</span>
                        </div>

                    </div>
                </t>
            </templates>

        </kanban>
    </field>
</record>

    <!-- SEARCH VIEW -->
<record id="view_hospital_doctor_search" model="ir.ui.view">
    <field name="name">hospital.doctor.search</field>
    <field name="model">hr_hospital.doctor</field>
    <field name="arch" type="xml">
        <search>

            <!-- Filters -->
            <filter string="Interns"
                    name="filter_interns"
                    domain="[('is_intern', '=', True)]"/>

            <filter string="Mentors"
                    name="filter_mentors"
                    domain="[('is_intern', '=', False)]"/>

        </search>
    </field>
</record>

</odoo>