<odoo>

    <record id="view_hospital_patient_list" model="ir.ui.view">
        <field name="name">hospital.patient.list</field>
        <field name="model">hr_hospital.patient</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="gender"/>
                <field name="phone"/>
                <field name="blood_group"/>
                <field name="personal_doctor_id"/>
                <field name="age"/>
            </list>
        </field>
    </record>

    <record id="view_hospital_patient_form" model="ir.ui.view">
        <field name="name">hospital.patient.form</field>
        <field name="model">hr_hospital.patient</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <!-- Button: open patient visits -->
                    <div class="oe_button_box" name="button_box">
                        <button type="object"
                                name="action_open_patient_visits"
                                class="oe_stat_button"
                                icon="fa-list">
                            <field name="name" string="Visits"/>
                        </button>
                    </div>

                    <!-- Button: create visit -->
                    <button name="action_create_visit"
                            type="object"
                            string="Create Visit"
                            class="btn-primary"/>

                    <group>
                        <field name="name"/>
                        <field name="phone"/>
                        <field name="gender"/>
                        <field name="birth_date"/>
                        <field name="user_id"/>
                        <field name="age"/>
                    </group>
                    <group>
                        <field name="personal_doctor_id" domain="[('is_intern', '=', False)]"/>
                        <field name="insurance_policy"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- SEARCH VIEW -->
    <record id="view_hospital_patient_search" model="ir.ui.view">
        <field name="name">hospital.patient.search</field>
        <field name="model">hr_hospital.patient</field>
        <field name="arch" type="xml">
            <search>
                <!-- Search by name -->
                <field name="name"/>

                <!-- Search by phone -->
                <field name="phone"/>
            </search>
        </field>
    </record>

</odoo>