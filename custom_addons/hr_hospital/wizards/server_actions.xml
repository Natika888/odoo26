<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- MASS REASSIGN DOCTOR -->
    <record id="action_mass_reassign_doctor" model="ir.actions.server">
        <field name="name">Reassign Doctor</field>
        <field name="model_id" ref="model_hr_hospital_patient"/>
        <field name="binding_model_id" ref="model_hr_hospital_patient"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code"><![CDATA[
action = {
    "type": "ir.actions.act_window",
    "res_model": "mass.reassign.doctor.wizard",
    "view_mode": "form",
    "target": "new",
    "context": {
        "active_model": records._name,
        "active_ids": records.ids
    }
}
        ]]></field>
    </record>

    <!-- VISIT REPORT (PATIENT) -->
    <record id="action_visit_report_patient" model="ir.actions.server">
        <field name="name">Visit Report (Patients)</field>
        <field name="model_id" ref="model_hr_hospital_patient"/>
        <field name="binding_model_id" ref="model_hr_hospital_patient"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code"><![CDATA[
action = {
    "type": "ir.actions.act_window",
    "res_model": "visit.report.wizard",
    "view_mode": "form",
    "target": "new",
    "context": {
        "active_model": records._name,
        "active_ids": records.ids
    }
}
        ]]></field>
    </record>

    <!-- VISIT REPORT (DOCTOR) -->
    <record id="action_visit_report_doctor" model="ir.actions.server">
        <field name="name">Visit Report (Doctors)</field>
        <field name="model_id" ref="model_hr_hospital_doctor"/>
        <field name="binding_model_id" ref="model_hr_hospital_doctor"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code"><![CDATA[
action = {
    "type": "ir.actions.act_window",
    "res_model": "visit.report.wizard",
    "view_mode": "form",
    "target": "new",
    "context": {
        "active_model": records._name,
