<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_visit_report_wizard_form" model="ir.ui.view">
        <field name="name">visit.report.wizard.form</field>
        <field name="model">visit.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Visit Report">
                <group>
                    <field name="doctor_ids"/>
                    <field name="patient_ids"/>
                </group>

                <group>
                    <field name="date_from"/>
                    <field name="date_to"/>
                </group>

                <group>
                    <field name="only_done"/>
                    <field name="disease_id"/>
                </group>

                <footer>
                    <button name="action_show_visits"
                            string="Show Visits"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>